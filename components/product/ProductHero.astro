---
import { Button, TransparentButton } from "../ui/Button";
import { PRODUCT_COMMON as C } from "../../data/site";
import type { Product } from "../../data/site";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const firstSection = product.sections[0] ?? "overview";
---

<section class="relative flex min-h-[70vh] w-full items-center overflow-hidden">
  <div class="product-bg absolute inset-0"></div>
  <div class="from-background absolute inset-0 bg-gradient-to-t to-transparent">
  </div>
  <div
    class="max-w-8xl relative z-10 mx-auto flex w-full flex-col items-start gap-4 px-8 pt-32 pb-16 md:px-12 lg:px-16 xl:px-24"
  >
    <div class="text-subtle text-sm" data-aos="fade-down">
      <a href="/" class="hover:text-foreground transition-colors"
        >{C.breadcrumbHome}</a
      >
      <span class="mx-1">&rsaquo;</span>
      <span>{product.title}</span>
    </div>
    <span
      class="border-border-strong bg-translucent text-muted rounded-full border px-3 py-1 text-xs tracking-wide backdrop-blur-sm"
      data-aos="fade-right"
    >
      {product.tagline}
    </span>
    <h1
      class="text-4xl leading-snug font-semibold lg:text-5xl xl:text-6xl"
      data-aos="fade-right"
    >
      {product.title}
    </h1>
    <h2
      class="gradient-text text-2xl font-semibold lg:text-3xl"
      data-aos="fade-right"
      data-aos-delay="100"
    >
      {product.subtitle}
    </h2>
    {
      product.desc && (
        <p
          class="text-muted max-w-xl text-lg"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          {product.desc}
        </p>
      )
    }
    <div
      class="mt-4 flex flex-col gap-4 md:flex-row"
      data-aos="fade-up"
      data-aos-delay="300"
    >
      <Button
        href={`#${firstSection}`}
        className="flex w-fit items-center gap-2"
      >
        <span class="text-lg">{C.learnMore}</span>
      </Button>
      <TransparentButton
        href="/#contact"
        className="flex w-fit items-center gap-2"
      >
        <span class="text-lg">{C.consult}</span>
      </TransparentButton>
    </div>
  </div>
</section>
