---
import { Button, TransparentButton } from "../ui/Button";
import { PRODUCT_COMMON as C } from "../../data/site";
import type { Product } from "../../data/site";

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<section
  class="border-border relative overflow-hidden rounded-2xl border p-12 text-center lg:p-16"
  data-reveal="zoom-in"
>
  <div class="product-cta-bg absolute inset-0"></div>
  <div class="relative z-10 flex flex-col items-center gap-4">
    <h2 class="text-3xl font-semibold lg:text-4xl">
      {product.ctaTitle ?? C.ctaTitle}
    </h2>
    <p class="text-muted text-lg">{product.ctaSub}</p>
    <div class="mt-4 flex flex-col gap-4 md:flex-row">
      {
        product.primaryHref && (
          <Button
            href={product.primaryHref}
            className="flex w-fit items-center gap-2"
          >
            <span class="text-lg">{product.primaryLabel ?? "在线使用"}</span>
          </Button>
        )
      }
      {
        !product.primaryHref && product.downloadHref && (
          <Button
            href={product.downloadHref}
            className="flex w-fit items-center gap-2"
          >
            <span class="text-lg">立即下载</span>
          </Button>
        )
      }
      <Button href={C.ctaJoinHref} className="flex w-fit items-center gap-2">
        <span class="text-lg">{C.ctaJoin}</span>
      </Button>
      <TransparentButton
        href="/#contact"
        className="flex w-fit items-center gap-2"
      >
        <span class="text-lg">{C.ctaBack}</span>
      </TransparentButton>
      {
        product.feedback && (
          <TransparentButton
            href={product.feedback.href}
            className="flex w-fit items-center gap-2"
          >
            <span class="text-lg">{product.feedback.text}</span>
          </TransparentButton>
        )
      }
    </div>
  </div>
</section>
