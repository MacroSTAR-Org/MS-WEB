---
import { PRODUCT_COMMON as C } from "../../data/site";
import type { ProductPricingData } from "../../data/site";

interface Props {
  data: ProductPricingData;
}

const { data } = Astro.props;
---

<section id="pricing" class="scroll-mt-24">
  <div class="mb-12 flex flex-col gap-4" data-reveal="fade-up">
    <h2 class="text-3xl font-semibold lg:text-4xl">{C.pricingTitle}</h2>
    <p class="text-subtle text-lg">{data.sub}</p>
  </div>
  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      data.tiers.map((tier, idx) => (
        <div
          class={`ease-out relative flex flex-col gap-4 rounded-2xl border p-8 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg ${
            tier.highlight
              ? "border-accent bg-card-hover"
              : "border-border bg-card"
          }`}
          data-reveal="fade-up"
          data-reveal-delay={Math.min(idx * 60, 240)}
        >
          {tier.highlight && (
            <span class="bg-accent text-background absolute -top-3 right-6 rounded-full px-3 py-1 text-xs font-semibold">
              {C.recommend}
            </span>
          )}
          <h4 class="text-xl font-semibold">{tier.name}</h4>
          <p class="text-3xl font-semibold">{tier.price}</p>
          <p class="text-subtle text-sm">{tier.desc}</p>
          <ul class="text-muted flex flex-col gap-2 text-sm">
            {tier.features.map((f) => (
              <li class="flex gap-2">
                <span class="text-accent">&check;</span>
                <span>{f}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
