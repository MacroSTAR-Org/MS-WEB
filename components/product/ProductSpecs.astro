---
import { PRODUCT_COMMON as C } from "../../data/site";
import type { ProductSpecsData } from "../../data/site";

interface Props {
  data: ProductSpecsData;
}

const { data } = Astro.props;
---

<section id="specs" class="scroll-mt-24">
  <div class="mb-8 flex flex-col gap-4" data-reveal="fade-up">
    <h2 class="text-3xl font-semibold lg:text-4xl">{C.specsTitle}</h2>
    <p class="text-subtle text-lg">{data.sub}</p>
  </div>
  <div
    class="divide-border border-border divide-y overflow-hidden rounded-2xl border"
    data-reveal="fade-up"
    data-reveal-delay="60"
  >
    {
      data.items.map((s) => (
        <div class="bg-card flex flex-col gap-1 px-6 py-4 md:flex-row md:items-center md:gap-8">
          <span class="text-subtle w-40 shrink-0 text-sm">{s.label}</span>
          <span class="text-muted">{s.value}</span>
        </div>
      ))
    }
  </div>
</section>
