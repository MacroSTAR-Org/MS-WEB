---
import type { ProductCodeData } from "../../data/site";

interface Props {
  data: ProductCodeData;
}

const { data } = Astro.props;
const hasSteps = (data.steps?.length ?? 0) > 0;
---

<section id="code" class="scroll-mt-24">
  <div class="mb-12 flex flex-col gap-4" data-reveal="fade-up">
    <h2 class="text-3xl font-semibold lg:text-4xl">{data.title}</h2>
    {data.sub && <p class="text-subtle text-lg">{data.sub}</p>}
  </div>
  <div class={hasSteps ? "grid grid-cols-1 gap-8 lg:grid-cols-5" : ""}>
    <div class={hasSteps ? "lg:col-span-3" : ""} data-reveal="fade-up">
      <div class="border-border overflow-hidden rounded-2xl border bg-black/50">
        <div class="border-border flex items-center gap-2 border-b px-5 py-3">
          <span class="h-3 w-3 rounded-full bg-red-500/80"></span>
          <span class="h-3 w-3 rounded-full bg-yellow-500/80"></span>
          <span class="h-3 w-3 rounded-full bg-green-500/80"></span>
          <span class="text-subtle ml-2 text-xs tracking-wide"
            >{data.language}</span
          >
        </div>
        <pre
          class="overflow-x-auto p-6 text-sm leading-relaxed"><code class="font-mono text-gray-200">{data.code}</code></pre>
      </div>
    </div>
    {
      hasSteps && (
        <div
          class="flex flex-col gap-4 lg:col-span-2"
          data-reveal="fade-up"
          data-reveal-delay="60"
        >
          {data.steps.map((step, idx) => (
            <div class="border-border bg-card flex gap-4 rounded-2xl border p-5">
              <span class="bg-translucent text-accent flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-sm font-semibold">
                {idx + 1}
              </span>
              <p class="text-muted">{step}</p>
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>
