---
import { PRODUCT_COMMON as C } from "../../data/site";
import type { ProductFAQData } from "../../data/site";

interface Props {
  data: ProductFAQData;
}

const { data } = Astro.props;
---

<section id="faq" class="scroll-mt-24">
  <div class="mb-12 flex flex-col gap-4" data-reveal="fade-up">
    <h2 class="text-3xl font-semibold lg:text-4xl">{C.faqTitle}</h2>
    <p class="text-subtle text-lg">{data.sub}</p>
  </div>
  <div
    class="divide-border border-border divide-y overflow-hidden rounded-2xl border"
    data-reveal="fade-up"
    data-reveal-delay="60"
  >
    {
      data.items.map((item) => (
        <details class="group bg-card">
          <summary class="hover:bg-card-hover flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-4 font-medium transition-colors [&::-webkit-details-marker]:hidden">
            <span>{item.q}</span>
            <span class="text-subtle text-xl transition-transform duration-300 group-open:rotate-45">
              +
            </span>
          </summary>
          <p class="text-muted px-6 pb-5">{item.a}</p>
        </details>
      ))
    }
  </div>
</section>
