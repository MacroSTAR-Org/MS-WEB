---
import { PRODUCT_COMMON as C } from "../../data/site";
import type { ProductLinksData } from "../../data/site";

interface Props {
  data: ProductLinksData;
}

const { data } = Astro.props;
---

<section id="links" class="scroll-mt-24">
  <div class="mb-12 flex flex-col gap-4" data-aos="fade-up">
    <h2 class="text-3xl font-semibold lg:text-4xl">{C.linksTitle}</h2>
    <p class="text-subtle text-lg">{data.sub}</p>
  </div>
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
    {
      data.items.map((link, idx) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener"
          class="ease-bounce group border-border bg-card hover:bg-card-hover flex flex-col gap-2 rounded-2xl border p-6 transition-all duration-300 hover:scale-[1.02]"
          data-aos="fade-up"
          data-aos-delay={idx * 100}
        >
          <span class="flex items-center gap-2 font-semibold">
            {link.text}
            <span class="text-subtle transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
              &nearr;
            </span>
          </span>
          {link.desc && <span class="text-subtle text-sm">{link.desc}</span>}
        </a>
      ))
    }
  </div>
</section>
