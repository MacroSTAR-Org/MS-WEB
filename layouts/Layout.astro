---
import "@/styles/global.css";
import Footer from "../components/layout/Footer";
import Header from "../components/layout/Header";
import { ClientRouter } from "astro:transitions";
import RevealInit from "../components/RevealInit.astro";
import { SITE } from "../data/site";

const { title } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* 预加载正文/标题字重，降低字体闪烁（FOUT） */}
    <link
      rel="preload"
      href="/fonts/misans-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/misans-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title ? `${title} - ${SITE.title}` : SITE.title}</title>
    {/* 首帧前应用主题，避免闪烁；空/system 时移除属性以跟随系统 */}
    <script is:inline>
      (function () {
        try {
          document.documentElement.classList.add("js");
          var t = localStorage.getItem("theme");
          var root = document.documentElement;
          if (t === "light" || t === "dark") {
            root.setAttribute("data-theme", t);
          } else {
            root.removeAttribute("data-theme");
          }
        } catch (e) {}
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <Header client:load initialPath={Astro.url.pathname} />
    <main>
      <slot />
    </main>
    <Footer />
    <RevealInit />
    {/* 视图转场后兜底重应用主题（<html> 属性通常已保留，此处防御性处理） */}
    <script>
      document.addEventListener("astro:after-swap", () => {
        try {
          const t = localStorage.getItem("theme");
          const root = document.documentElement;
          if (t === "light" || t === "dark") {
            root.setAttribute("data-theme", t);
          } else {
            root.removeAttribute("data-theme");
          }
        } catch (e) {}
      });
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
