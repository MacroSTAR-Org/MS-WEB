---
import FriendlyLinks from "../components/FriendlyLinks";
import Hero from "../components/Hero";
import HonorWall from "../components/HonorWall";
import MemberWall from "../components/MemberWall";
import ProductCarousel from "../components/ProductCarousel";
import ContactSection from "../components/ContactSection";
import Layout from "../layouts/Layout.astro";
---

<Layout transition:animate="fade">
  <Hero />
  <div class="max-w-8xl mx-auto flex flex-col gap-16 overflow-hidden py-16">
    <div
      class="ease-out flex flex-col gap-24 px-8 transition-all duration-500 md:px-12 lg:px-16 xl:px-24"
    >
      <ProductCarousel client:visible />
      <ContactSection />
      <MemberWall />
      <HonorWall />
      <FriendlyLinks />
    </div>
  </div>
</Layout>
