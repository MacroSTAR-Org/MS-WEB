---
import Layout from "../../layouts/Layout.astro";
import { Button, TransparentButton } from "../../components/ui/Button";
import { PRODUCTS, PRODUCT_COMMON as C } from "../../data/site";

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const others = PRODUCTS.filter((p) => p.slug !== product.slug);
---

<Layout title={product.title} transition:animate="slide">
  <!-- ============ 产品 Hero ============ -->
  <section class="relative flex min-h-[70vh] w-full items-center overflow-hidden">
    <div class="product-bg absolute inset-0"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-background to-transparent">
    </div>
    <div
      class="max-w-8xl relative z-10 mx-auto flex w-full flex-col items-start gap-4 px-8 pt-32 pb-16 md:px-12 lg:px-16 xl:px-24"
    >
      <div class="text-sm text-subtle" data-aos="fade-down">
        <a href="/" class="transition-colors hover:text-foreground"
          >{C.breadcrumbHome}</a
        >
        <span class="mx-1">&rsaquo;</span>
        <span>{product.title}</span>
      </div>
      <span
        class="rounded-full border border-border-strong bg-translucent px-3 py-1 text-xs tracking-wide text-muted backdrop-blur-sm"
        data-aos="fade-right"
      >
        {product.tagline}
      </span>
      <h1
        class="text-4xl leading-snug font-semibold lg:text-5xl xl:text-6xl"
        data-aos="fade-right"
      >
        {product.title}
      </h1>
      <h2
        class="gradient-text text-2xl font-semibold lg:text-3xl"
        data-aos="fade-right"
        data-aos-delay="100"
      >
        {product.subtitle}
      </h2>
      {
        product.desc && (
          <p
            class="max-w-xl text-lg text-muted"
            data-aos="fade-up"
            data-aos-delay="200"
          >
            {product.desc}
          </p>
        )
      }
      <div
        class="mt-4 flex flex-col gap-4 md:flex-row"
        data-aos="fade-up"
        data-aos-delay="300"
      >
        <Button href="#overview" className="flex w-fit items-center gap-2">
          <span class="text-lg">{C.learnMore}</span>
        </Button>
        <TransparentButton
          href="/#contact"
          className="flex w-fit items-center gap-2"
        >
          <span class="text-lg">{C.consult}</span>
        </TransparentButton>
      </div>
    </div>
  </section>

  <div class="max-w-8xl mx-auto flex flex-col gap-24 overflow-hidden px-8 py-16 md:px-12 lg:px-16 xl:px-24">
    <!-- ============ 产品概述 ============ -->
    <section id="overview" class="scroll-mt-24">
      <div class="mb-8 flex flex-col gap-4" data-aos="fade-up">
        <h2 class="text-3xl font-semibold lg:text-4xl">{C.overviewTitle}</h2>
        <p class="text-lg text-subtle">{product.overviewSub}</p>
      </div>
      <div
        class="flex flex-col gap-4 text-muted"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        {product.paragraphs.map((p) => <p class="leading-relaxed">{p}</p>)}
        <h3 class="mt-4 text-xl font-semibold text-foreground">{C.advTitle}</h3>
        <p class="leading-relaxed">{product.advantage}</p>
      </div>
    </section>

    <!-- ============ 核心特�?============ -->
    <section>
      <div class="mb-12 flex flex-col gap-4" data-aos="fade-up">
        <h2 class="text-3xl font-semibold lg:text-4xl">{C.featuresTitle}</h2>
        <p class="text-lg text-subtle">{product.featuresSub}</p>
      </div>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
        {
          product.features.map((f, idx) => (
            <div
              class="ease-bounce flex flex-col gap-3 rounded-2xl border border-border bg-card p-8 transition-all duration-300 hover:scale-[1.02] hover:bg-card-hover"
              data-aos="fade-up"
              data-aos-delay={idx * 100}
            >
              <span class="text-3xl">{f.icon}</span>
              <h4 class="text-xl font-semibold">{f.title}</h4>
              <p class="text-subtle">{f.desc}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ============ 技术参�?============ -->
    <section>
      <div class="mb-8 flex flex-col gap-4" data-aos="fade-up">
        <h2 class="text-3xl font-semibold lg:text-4xl">{C.specsTitle}</h2>
        <p class="text-lg text-subtle">{C.specsSub}</p>
      </div>
      <div
        class="divide-y divide-border overflow-hidden rounded-2xl border border-border"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        {
          product.specs.map((s) => (
            <div class="flex flex-col gap-1 bg-card px-6 py-4 md:flex-row md:items-center md:gap-8">
              <span class="w-40 shrink-0 text-sm text-subtle">{s.label}</span>
              <span class="text-muted">{s.value}</span>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ============ CTA 咨询 ============ -->
    <section
      class="relative overflow-hidden rounded-2xl border border-border p-12 text-center lg:p-16"
      data-aos="zoom-in"
    >
      <div class="product-cta-bg absolute inset-0"></div>
      <div class="relative z-10 flex flex-col items-center gap-4">
        <h2 class="text-3xl font-semibold lg:text-4xl">{C.ctaTitle}</h2>
        <p class="text-lg text-muted">{product.ctaSub}</p>
        <div class="mt-4 flex flex-col gap-4 md:flex-row">
          <Button
            href={`mailto:${product.email}`}
            className="flex w-fit items-center gap-2"
          >
            <span class="text-lg">{C.ctaEmail}</span>
          </Button>
          <TransparentButton
            href="/#contact"
            className="flex w-fit items-center gap-2"
          >
            <span class="text-lg">{C.ctaBack}</span>
          </TransparentButton>
        </div>
      </div>
    </section>

    <!-- ============ 其他产品 ============ -->
    <section>
      <h2 class="mb-8 text-3xl font-semibold lg:text-4xl" data-aos="fade-up">
        {C.othersTitle}
      </h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
        {
          others.map((p, idx) => (
            <a
              href={`/products/${p.slug}`}
              class="ease-bounce group flex flex-col gap-2 rounded-2xl border border-border bg-card p-6 transition-all duration-300 hover:scale-[1.02] hover:bg-card-hover"
              data-aos="fade-up"
              data-aos-delay={idx * 50}
            >
              <span class="text-lg font-semibold">{p.title}</span>
              <span class="text-sm text-subtle">{p.subtitle}</span>
              <span class="mt-2 text-sm text-accent transition-colors group-hover:text-accent-hover">
                {C.viewDetail}
              </span>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</Layout>
