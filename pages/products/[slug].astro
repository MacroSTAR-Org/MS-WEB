---
import Layout from "../../layouts/Layout.astro";
import ProductHero from "../../components/product/ProductHero.astro";
import ProductOverview from "../../components/product/ProductOverview.astro";
import ProductGallery from "../../components/product/ProductGallery.astro";
import ProductFeatures from "../../components/product/ProductFeatures.astro";
import ProductCodeDemo from "../../components/product/ProductCodeDemo.astro";
import ProductSpecs from "../../components/product/ProductSpecs.astro";
import ProductPricing from "../../components/product/ProductPricing.astro";
import ProductFAQ from "../../components/product/ProductFAQ.astro";
import ProductLinks from "../../components/product/ProductLinks.astro";
import ProductCTA from "../../components/product/ProductCTA.astro";
import ProductOthers from "../../components/product/ProductOthers.astro";
import { PRODUCTS } from "../../data/site";
import type { ProductTheme, ProductThemeSet } from "../../data/site";

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;

/** 由产品主题数据生成页面 CSS：深色为默认，浅色随系统偏好 / 手动切换翻转 */
function themeCss(slug: string, theme: ProductTheme): string {
  const sel = `.product-scope[data-product="${slug}"]`;
  const block = (v: ProductThemeSet) =>
    `${sel}{--product-radial:${v.radial};--product-cta-radial:${v.ctaRadial};--grad-1:${v.grad1};--grad-2:${v.grad2};--grad-3:${v.grad3};--accent:${v.accent};--accent-hover:${v.accentHover}}`;
  return `${block(theme.dark)}@media (prefers-color-scheme: light){:root:not([data-theme]) ${block(theme.light)}}:root[data-theme="light"] ${block(theme.light)}`;
}

const scopeCss = themeCss(product.slug, product.theme);
---

<Layout title={product.title} transition:animate="fade">
  <style is:inline set:html={scopeCss}></style>
  <div class="product-scope" data-product={product.slug}>
    <!-- ============ 产品 Hero（公共骨架） ============ -->
    <ProductHero product={product} />

    <div
      class="max-w-8xl mx-auto flex flex-col gap-24 overflow-hidden px-8 py-16 md:px-12 lg:px-16 xl:px-24"
    >
      <!-- ============ 内容区块（按产品声明的顺序渲染） ============ -->
      {
        product.sections.map((s) => {
          switch (s) {
            case "overview":
              return (
                product.overview && <ProductOverview data={product.overview} />
              );
            case "gallery":
              return (
                product.gallery && <ProductGallery data={product.gallery} />
              );
            case "features":
              return (
                product.features && <ProductFeatures data={product.features} />
              );
            case "code":
              return product.code && <ProductCodeDemo data={product.code} />;
            case "specs":
              return product.specs && <ProductSpecs data={product.specs} />;
            case "pricing":
              return (
                product.pricing && <ProductPricing data={product.pricing} />
              );
            case "faq":
              return product.faq && <ProductFAQ data={product.faq} />;
            case "links":
              return product.links && <ProductLinks data={product.links} />;
            default:
              return null;
          }
        })
      }

      <!-- ============ CTA 咨询（公共骨架） ============ -->
      <ProductCTA product={product} />

      <!-- ============ 其他产品（公共骨架） ============ -->
      <ProductOthers current={product} />
    </div>
  </div>
</Layout>
